# ==============================================================================
# FOMBO MUSIC AI — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & SERVER
# ------------------------------------------------------------------------------
APP_ENV=development                    # development, staging, production
APP_NAME="Fombo Music AI"
DEBUG=true
PORT=8000
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 2. SECURITY & AUTHENTICATION (JWT)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
SECRET_KEY=change_this_to_a_secure_random_64_character_string_for_production_use
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# ------------------------------------------------------------------------------
# 3. DATABASE (POSTGRESQL & SQLITE FALLBACK)
# ------------------------------------------------------------------------------
# Production PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/fombo_music
# Local dev/test default uses SQLite when PostgreSQL is unconfigured:
DATABASE_URL=sqlite+aiosqlite:///./fombo_music.db
SYNC_DATABASE_URL=sqlite:///./fombo_music.db

# ------------------------------------------------------------------------------
# 4. CACHING, BROKER & CELERY (REDIS)
# ------------------------------------------------------------------------------
# When REDIS_URL is unconfigured, system falls back to in-memory async job queue for dev
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ------------------------------------------------------------------------------
# 5. OBJECT STORAGE (AWS S3 / CLOUDFLARE R2 / MINIO / LOCAL STORAGE)
# ------------------------------------------------------------------------------
STORAGE_BACKEND=local                   # 'local' or 's3'
LOCAL_STORAGE_DIR=./storage_data
S3_ENDPOINT_URL=                        # Leave blank for standard AWS S3
S3_REGION=us-east-1
S3_BUCKET_NAME=fombo-music-assets
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SIGNED_URL_EXPIRATION_SECONDS=3600

# ------------------------------------------------------------------------------
# 6. AI AUDIO MODEL PROVIDERS & INFERENCE ENDPOINTS
# ------------------------------------------------------------------------------
# Strict Truthfulness Policy:
# If keys are missing, the UI gracefully informs the user that provider credentials
# are required. Procedural synthesis is instrumental-only and never a vocal fallback.

# Provider: Separate ACE-Step 1.5 CUDA worker (official MIT checkpoint)
ACE_STEP_SERVICE_URL=                   # private GPU worker endpoint, e.g. http://127.0.0.1:8001
ACE_STEP_API_TOKEN=                     # same random secret >=24 characters on API and worker
ACE_STEP_MODEL_REVISION=19671f406d603126926c1b7e2adc169acbcade22
GENERATION_TIMEOUT_SECONDS=1800
ACE_STEP_POLL_INTERVAL_SECONDS=2
# GPU host only: ACE_STEP_PROJECT_ROOT, ACESTEP_CHECKPOINTS_DIR, ACE_STEP_JOB_DIR
# See workers/ace_step/README.md for pinned provisioning; no model runs in Next.js.

# Provider: Built-in Procedural Audio DSP (Always available, zero config needed)
ENABLE_PROCEDURAL_SYNTH=true

# Provider: Audiocraft / MusicGen (Self-hosted PyTorch inference service or Replicate)
AUDIOCRAFT_SERVICE_URL=                 # e.g., http://localhost:8080/inference
REPLICATE_API_TOKEN=                    # For Replicate MusicGen hosted fallback

# Provider: Suno API Adapter
SUNO_API_URL=                           # e.g., your verified proxy endpoint (no standard contract assumed)
SUNO_API_KEY=

# Provider: Stability Audio
STABILITY_API_KEY=

# Provider: Demucs Stem Separation Worker
DEMUCS_SERVICE_URL=                     # e.g., http://localhost:8081/separate

# Provider: Voice Cloning / Synthesis
VOICE_SYNTH_SERVICE_URL=

# ------------------------------------------------------------------------------
# 7. LLM PROVIDERS FOR AI LYRICS INTELLIGENCE LAB
# ------------------------------------------------------------------------------
# Provider mode: 'auto', 'openai', 'anthropic', 'ollama', or 'local_engine'
LLM_PROVIDER=auto
OPENAI_API_KEY=                         # sk-proj-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_BASE=                        # Leave empty for https://api.openai.com/v1
ANTHROPIC_API_KEY=                      # sk-ant-...
OLLAMA_SERVICE_URL=                     # e.g., http://localhost:11434
LOCAL_LLM_MODEL=llama3


# ------------------------------------------------------------------------------
# 7. SUBSCRIPTIONS & COMMERCE (STRIPE)
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_STUDIO=

# ------------------------------------------------------------------------------
# 8. TRUST, SAFETY & CONTENT MODERATION
# ------------------------------------------------------------------------------
MODERATION_STRICT_MODE=true
BANNED_ARTIST_NAMES="Taylor Swift,Drake,Beyonce,Beatles,Eminem,The Weeknd,Ed Sheeran,Michael Jackson,Billie Eilish"

# ------------------------------------------------------------------------------
# 9. FRONTEND NEXT.JS PUBLIC CONFIGURATION (frontend/.env.local)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws

# Supabase Authentication & Realtime
NEXT_PUBLIC_SUPABASE_URL=               # e.g., https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=          # e.g., eyJhbGciOi...

